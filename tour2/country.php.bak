<?php
require "db.php";

$country   = isset($_GET["country"]) ? (string) $_GET["country"] : "UK";
$transport = isset($_GET["transport"]) ? (string) $_GET["transport"] : "bus";
$stars     = isset($_GET["stars"]) ? (int) $_GET["stars"] : 3;
$price     = isset($_GET["price"]) ? (int) $_GET["price"] : 1000;

$stars = max(1, min(5, $stars));
$price = max(100, min(1000, $price));

$transportMap = ['plane' => 'airplane', 'bus' => 'bus', 'train' => 'train'];
$transport = $transportMap[$transport] ?? $transport;

include "header.php";
?>
<section class="wrap block" style="padding-block:var(--sp-5) var(--sp-6);">
    <h1 style="font-family:var(--font-head);font-size:var(--fs-h2);margin-bottom:var(--sp-4);">Результати пошуку</h1>
    <p style="font-size:var(--fs-small);color:#52676a;margin-bottom:var(--sp-4);">
        Країна: <strong><?= htmlspecialchars($country, ENT_QUOTES, 'UTF-8') ?></strong> |
        Транспорт: <strong><?= htmlspecialchars($transport, ENT_QUOTES, 'UTF-8') ?></strong> |
        Мін. зірки: <strong><?= $stars ?></strong> |
        Макс. ціна: <strong><?= $price ?> €</strong>
    </p>

<?php
$matched = [];
foreach ($tours as $tour) {
    if ($tour['country'] !== $country) {
        continue;
    }
    if ($tour['transport'] !== $transport) {
        continue;
    }
    if ((int) $tour['stars'] < $stars) {
        continue;
    }
    if ((int) $tour['price'] > $price) {
        continue;
    }
    $matched[] = $tour;
}

if (empty($matched)) {
    echo "<p style='font-size:var(--fs-small);color:#52676a;'>Турів не знайдено</p>";
} else {
    echo '<div class="grid" id="grid">';
    foreach ($matched as $i => $tour) {
        echo '<article class="card" style="--d:' . (($i % 3) * 80) . 'ms" aria-labelledby="h-tour-' . $i . '">';
        echo '  <div class="card-img">';
        echo '    <img src="https://images.unsplash.com/photo-' . htmlspecialchars($tour['img'], ENT_QUOTES, 'UTF-8') . '?auto=format&fit=crop&w=600&q=70" alt="' . htmlspecialchars($tour['name'], ENT_QUOTES, 'UTF-8') . '" width="600" height="450" loading="lazy">';
        echo '  </div>';
        echo '  <div class="card-body">';
        echo '    <div>';
        echo '      <p class="route">' . htmlspecialchars($tour['country'], ENT_QUOTES, 'UTF-8') . '</p>';
        echo '      <h3 id="h-tour-' . $i . '">' . htmlspecialchars($tour['name'], ENT_QUOTES, 'UTF-8') . '</h3>';
        echo '    </div>';
        echo '    <dl class="meta">';
        echo '      <div class="wide"><dt>Транспорт</dt><dd>' . htmlspecialchars($tour['transport'], ENT_QUOTES, 'UTF-8') . '</dd></div>';
        echo '      <div class="wide"><dt>Зірки</dt><dd>' . htmlspecialchars($tour['stars'], ENT_QUOTES, 'UTF-8') . '</dd></div>';
        echo '    </dl>';
        echo '    <div class="card-foot">';
        echo '      <div>';
        echo '        <div class="price">';
        echo '          <strong>' . htmlspecialchars($tour['price'], ENT_QUOTES, 'UTF-8') . ' €</strong>';
        echo '          <small>за особу</small>';
        echo '        </div>';
        echo '      </div>';
        echo '      <a class="btn btn-primary" href="#">Детальніше</a>';
        echo '    </div>';
        echo '  </div>';
        echo '</article>';
    }
    echo '</div>';
}
?>
</section>
<?php
include "footer.php";
?>